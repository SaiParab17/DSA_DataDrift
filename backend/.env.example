# ==============================================================================
# DataWatch Backend — Environment Configuration Template
# Copy this file to `backend/.env` for local development or set these variables
# in your production container environment (Render, Railway, Fly.io, etc.).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL / SQLite)
# ------------------------------------------------------------------------------
# Production PostgreSQL example (asyncpg driver is required for async operation):
# DATABASE_URL=postgresql+asyncpg://datawatch_user:secure_password@db-host.internal:5432/datawatch_prod
#
# Local development default (SQLite fallback):
DATABASE_URL=sqlite+aiosqlite:///./datawatch.db

# ------------------------------------------------------------------------------
# 2. CORS & Network Security
# ------------------------------------------------------------------------------
# Allowed frontend origins (comma-separated or single URL)
FRONTEND_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 3. Great Expectations Settings
# ------------------------------------------------------------------------------
# Disable outbound anonymous usage telemetry to avoid container startup timeouts
GX_ANONYMOUS_USAGE_STATISTICS=false

# ------------------------------------------------------------------------------
# 4. AWS S3 Object Storage (Student Account / Production)
# ------------------------------------------------------------------------------
# Name of the AWS S3 bucket for dataset persistence
AWS_S3_BUCKET_NAME=datawatch-student-bucket

# AWS Access Key ID from your AWS Academy / Student Learner Lab or IAM user
AWS_ACCESS_KEY_ID=your_aws_access_key_id

# AWS Secret Access Key
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# AWS Region where your S3 bucket resides (e.g., us-east-1, us-west-2, ap-south-1)
AWS_REGION=us-east-1

# Optional session token (required ONLY if using AWS Academy Learner Lab temporary credentials)
# AWS_SESSION_TOKEN=your_optional_session_token

